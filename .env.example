# Standalone Codestra Realtime local deployment.
# Copy to .env before using anything beyond localhost defaults.

POSTGRES_DB=realtime
POSTGRES_USER=realtime
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Bootstrap authentication is intended only to create the first durable API key.
# Rotate/remove its use from deployment automation after durable API keys are issued.
REALTIME_BOOTSTRAP_API_KEY=replace-with-a-long-random-bootstrap-secret
REALTIME_BOOTSTRAP_TENANT=local

# Host-side published port. compose.yaml binds it to 127.0.0.1 by default.
REALTIME_PORT=8787
